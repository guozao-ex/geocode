<?xml version="1.0" encoding="utf-8"?>
<!-- GeoCode add-in：ArcGIS Pro 3.7 活会话接入（change C9 p1b-arcgis-addin）
     部署布局：本文件置 zip 根，Install/*.dll 为程序集；zip 拷贝到
     [MyDocuments]\ArcGIS\AddIns\ArcGISPro（由 scripts/package_pro_addin.py 完成）。 -->
<ArcGIS defaultAssembly="GeoCodePro.dll"
        defaultNamespace="GeoCodePro"
        xmlns="http://schemas.esri.com/DADF/Registry">
  <AddInInfo id="GeoCodePro-MCP" version="1.0.0" desktopVersion="3.7">
    <Name>GeoCode Pro MCP</Name>
    <Description>GeoCode 活会话接入：HTTP MCP server（127.0.0.1:6530），pro_get_view_aoi / pro_add_layer / pro_export_view。仅个人学习使用，不分发。</Description>
    <Author>GeoCode</Author>
    <Date>2026-10-07</Date>
  </AddInInfo>

  <modules>
    <insertModule id="GeoCodePro_Module"
                  className="GeoCodePro.GeoCodeModule"
                  autoLoad="true"
                  caption="GeoCode Pro MCP">
      <description>在 Pro 进程内起 HTTP MCP server（127.0.0.1:6530）。</description>
      <tabs>
        <tab id="GeoCodePro_Tab" caption="GeoCode">
          <groupRef id="GeoCodePro_Group" />
        </tab>
      </tabs>
      <groups>
        <group id="GeoCodePro_Group" caption="MCP" appearsOn="GeoCodePro_Tab">
          <button refID="GeoCodePro_ServerStatus" size="large" />
        </group>
      </groups>
      <controls>
        <button id="GeoCodePro_ServerStatus"
                caption="MCP Server Status"
                className="GeoCodePro.ServerStatusButton"
                loadErrorMessage="GeoCode MCP 按钮加载失败。"
                message="查看 MCP server 状态"
                tooltip="查看 6530 MCP server 监听状态">
          <tooltipHeading>GeoCode MCP</tooltipHeading>
          <shortDescription>查看 MCP server 状态。</shortDescription>
          <longDescription>弹出 MCP server 监听状态（端口、工具数、请求数）。</longDescription>
        </button>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>
